# === PostgreSQL ===
POSTGRES_DB=vms
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminadmin
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=postgres

PGDATA=/var/lib/postgresql/data/pgdata
PGDATA_VOLUME=bsbd-data

PGADMIN_EMAIL=admin@local.lol
PGADMIN_PASSWORD=admin
PGADMIN_PORT=80
PGADMIN_CONTAINER_NAME=pgadmin
PGADMIN_VOLUME=bsbd-pgadmin